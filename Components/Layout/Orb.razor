<div id="Orb"
     style="
          background-color: #007bff;
          position: fixed;
          user-select: none;
          -webkit-user-drag: none;
          cursor:grab;
          touch-action: none;
          display: flex;
          justify-content: var(--justify-content);
          left: @(leftSpacing)%;
          top: @(topSpacing)%;
          transform: translateX(var(--translatexvalue));
          width: var(--final-orbwidth);
          height: var(--final-orbheight);
          border-radius: var(--border-radius);
          --border-radius: @(borderRadius)%;
          --final-orbwidth: @(orbwidth)vh;
          --final-orbheight: @(orbheight)vh;
          --justify-content: @(justifyContent);
          --translatexvalue: @(translatexvalue)%"

     @onpointerdown="Pdown"
     @onpointerup="Pup"
     @onpointermove="Pmove"
     @onpointerleave="Pleave">
     
     @if (orbState != 0)
     {
          <section id="navlinks">
               <a href="/Skills">Skills</a>
               <a href="/Projects">Projects</a>
               <a href="/Contact">Contact</a>
          </section>
     }
</div>

@code {
          double StartingFromX;
          double StartingFromY;
          double TravellingX;
          double TravellingY;
          double TravelledTox;
          double TravelledToy;
          bool isPenDown = false;
          int orbState = 0;
          int orbwidth = 10;
          int orbheight = 10;
          int borderRadius = 50;
          int leftSpacing = 4;
          int topSpacing = 2;
          string justifyContent = "left";
          int translatexvalue = -50;
          
          void Pdown(PointerEventArgs e)
          {
               isPenDown = true;
               StartingFromX = e.ClientX;
               StartingFromY = e.ClientY;
               Console.WriteLine($"Pointer down at: {StartingFromX}, {StartingFromY}");
          }

          void Pmove(PointerEventArgs e)
          {
               if (isPenDown == true)
               {
                    TravellingX = e.ClientX;
                    TravellingY = e.ClientY;
                    Console.WriteLine($"Pointer moved to: {TravellingX}, {TravellingY}");
               }
          }

          void Pup(PointerEventArgs e)
          {
               isPenDown = false;
               TravelledTox = e.ClientX;
               TravelledToy = e.ClientY;
               Console.WriteLine($"Pointer released at: {TravelledTox}, {TravelledToy}");
               Direction();
          }

          void Pleave(PointerEventArgs e)
          {
               if (isPenDown == true)
               {
                    isPenDown = false;
                    TravelledTox = e.ClientX;
                    TravelledToy = e.ClientY;
                    Console.WriteLine($"Pointer released at: {TravelledTox}, {TravelledToy}");
                    Direction();
               }


          }

          void Direction()
          {
               double absX = Math.Abs(TravelledTox - StartingFromX);
               double absY = Math.Abs(TravelledToy - StartingFromY);
               if (absX > absY)
               {
                    Console.WriteLine("Horizontal movement");
                    orbState = 1;
                    orbwidth = 30;
                    orbheight = 7;
                    borderRadius = 0;
                    leftSpacing = 50;
                    justifyContent = "center";
                    translatexvalue = -50;
               }
               else if (absY > absX)
               {
                    Console.WriteLine("Vertical movement");
                    orbState = 2;
                    orbheight = 100;
                    orbwidth = 10;
                    borderRadius = 0;
                    leftSpacing = 0;
                    topSpacing = 0;
                    translatexvalue = 0;
               }
               else
               {
                    Console.WriteLine("Clicked");
                    orbState = 0;
               }
          }

          

}




